{
  "name": "latex-editor",
  "private": true,
  "version": "0.1.0",
  "description": "AI-assisted local LaTeX workspace for technical-paper writing.",
  "license": "Apache-2.0",
  "author": "marcowus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcowus/latex-editor.git"
  },
  "bugs": {
    "url": "https://github.com/marcowus/latex-editor/issues"
  },
  "homepage": "https://github.com/marcowus/latex-editor#readme",
  "keywords": [
    "latex",
    "academic-writing",
    "research-tools",
    "control-systems",
    "ieee",
    "llm",
    "react",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jszip": "^3.4.1",
    "@types/katex": "^0.16.8",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
