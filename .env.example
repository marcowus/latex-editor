# Copy this file to .env. Never commit .env or paste a real key into an issue,
# screenshot, pull request, or terminal transcript.
#
# The application is local-only by default. Set LATEX_EDITOR_HOST=0.0.0.0 only
# when deliberately sharing it on a trusted network with suitable access control.
LATEX_EDITOR_HOST="127.0.0.1"

# Optional default provider and model. Supported provider ids are documented in
# docs/LLM_API_GUIDE.md and surfaced by GET /api/llm/status.
DEFAULT_LLM_PROVIDER="antigravity"
DEFAULT_LLM_MODEL=""

# Configure only the provider(s) you intend to use. Leave unused values blank.
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
SILICONFLOW_API_KEY=""
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"

# Optional OpenAI-compatible endpoint, including a local model server.
CUSTOM_API_KEY=""
CUSTOM_BASE_URL="http://localhost:11434/v1"
CUSTOM_MODEL="custom-model"

# Optional local Zotero MCP and Better BibTeX bridge.
ZOTERO_MCP_URL="http://127.0.0.1:23120/mcp"
ZOTERO_BBT_URL="http://127.0.0.1:23119"
